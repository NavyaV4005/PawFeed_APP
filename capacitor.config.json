{
  "$schema": "https://capacitorjs.com/schema.json",
  "appId": "com.pawfeed.app",
  "appName": "PawFeed",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "http"
  },
  "plugins": {
    "GoogleAuth": {
      "scopes": ["profile", "email"],
      "serverClientId": "559620223401-g8vifmtcsa3n63j9tfmsa4468sfnpn32.apps.googleusercontent.com",
      "forceCodeForRefreshToken": true
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": false,
      "backgroundColor": "#A8D8EA",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "iosSpinnerStyle": "small",
      "spinnerColor": "#ffffff"
    },
    "LocalNotifications": {
      "smallIcon": "ic_notification",
      "iconColor": "#A8D8EA",
      "sound": "beep.wav"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#ffffff",
      "overlaysWebView": false
    }
  }
}
